{"parametros":{"a":1.7,"c":0.25,"b":{"facil":-1,"media":0,"dificil":1}},"habilidades":[{"id":"derivadas","nombre":"Derivadas y sus reglas","peso":"5/17","preguntas":{"facil":{"texto":"Deriva f(x) = 3x⁴ − 5x + 2","correcta":"12x³ − 5","distractores":[["12x³ − 5x","no derivó el término lineal"],["3x³ − 5","no multiplicó por el exponente"],["12x⁴ − 5","no bajó el exponente"]]},"media":{"texto":"Deriva f(x) = x³ ln x","correcta":"3x² ln x + x²","distractores":[["3x","multiplicó las derivadas"],["3x² ln x","olvidó un término de la regla del producto"],["3x² + 1/x","sumó las derivadas"]]},"dificil":{"texto":"Deriva f(x) = x² / (x + 1)","correcta":"(x² + 2x) / (x + 1)²","distractores":[["2x","derivó arriba y abajo por separado"],["−(x² + 2x) / (x + 1)²","invirtió el orden en la regla del cociente"],["(x² + 2x) / (x + 1)","olvidó elevar el denominador"]]}}},{"id":"cadena","nombre":"Regla de la cadena","peso":"2/17","preguntas":{"facil":{"texto":"Deriva f(x) = (2x + 1)⁵","correcta":"10(2x + 1)⁴","distractores":[["5(2x + 1)⁴","olvidó la derivada interna"],["10x(2x + 1)⁴","tomó la derivada interna como 2x"],["10(2x + 1)⁵","no bajó el exponente"]]},"media":{"texto":"Deriva f(x) = sen(3x² + 1)","correcta":"6x cos(3x² + 1)","distractores":[["cos(3x² + 1)","olvidó la derivada interna"],["cos(6x)","derivó por dentro y por fuera por separado"],["−6x cos(3x² + 1)","signo de la derivada del seno"]]},"dificil":{"texto":"Deriva f(x) = √(x² + 1)","correcta":"x / √(x² + 1)","distractores":[["1 / (2√(x² + 1))","olvidó la derivada interna"],["2x / √(x² + 1)","olvidó el 1/2 del exponente"],["x√(x² + 1)","no le restó 1 al exponente"]]}}},{"id":"limites","nombre":"Límites y continuidad","peso":"2/17","preguntas":{"facil":{"texto":"Calcula el límite de x² + 2x cuando x → 3","correcta":"15","distractores":[["9","evaluó solo x²"],["6","evaluó solo 2x"],["11","tomó 2x como 2"]]},"media":{"texto":"Calcula el límite de (x² − 4)/(x − 2) cuando x → 2","correcta":"4","distractores":[["0","evaluó solo el numerador"],["No existe","se detuvo en 0/0"],["2","simplificó la fracción a x"]]},"dificil":{"texto":"Calcula el límite de (3x² + 1)/(x² − 5) cuando x → ∞","correcta":"3","distractores":[["∞","no comparó los grados"],["0","pensó que todo límite al infinito da 0"],["−1/5","sustituyó x = 0"]]}}},{"id":"trigonometria","nombre":"Identidades trigonométricas","peso":"2/17","preguntas":{"facil":{"texto":"¿A qué es igual 1 − cos²x?","correcta":"sen²x","distractores":[["cos²x","confundió el signo"],["sen x","olvidó el cuadrado"],["tan²x","confundió con la identidad de la tangente"]]},"media":{"texto":"Simplifica tan x · cos x","correcta":"sen x","distractores":[["1","pensó que tan x y cos x se cancelan"],["cos²x / sen x","usó tan x = cos x / sen x"],["sen x / cos²x","dividió entre cos x en lugar de multiplicar"]]},"dificil":{"texto":"Escribe sen²x en términos del ángulo doble","correcta":"(1 − cos 2x)/2","distractores":[["(1 + cos 2x)/2","es la de cos²x"],["2 sen x cos x","es sen 2x"],["1 − cos 2x","olvidó dividir entre 2"]]}}},{"id":"algebra","nombre":"Álgebra básica y funciones","peso":"4/17","preguntas":{"facil":{"texto":"Simplifica (x² − 9)/(x + 3)","correcta":"x − 3","distractores":[["x + 3","factorizó con el signo mal"],["x² − 3","canceló términos sueltos"],["No se puede simplificar","no reconoció la diferencia de cuadrados"]]},"media":{"texto":"Escribe ln(x²/y) como suma y resta de logaritmos","correcta":"2 ln x − ln y","distractores":[["ln 2x − ln y","bajó el exponente dentro del logaritmo"],["2 ln x / ln y","convirtió la resta en división"],["(ln x)² − ln y","elevó el logaritmo"]]},"dificil":{"texto":"¿En qué valores de x se cruzan y = x² y y = x + 2?","correcta":"x = −1 y x = 2","distractores":[["x = 1 y x = −2","signos al factorizar"],["Solo x = 2","perdió una raíz"],["No se cruzan","no igualó las funciones"]]}}},{"id":"polinomios","nombre":"Ceros de polinomios","peso":"1/17","preguntas":{"facil":{"texto":"¿Cuál es un cero de P(x) = x³ − 2x² − x + 2?","correcta":"x = 1","distractores":[["x = 0","no comprobó evaluando P (da 2)"],["x = 3","no comprobó evaluando P (da 8)"],["x = −2","no comprobó evaluando P (da −12)"]]},"media":{"texto":"Factoriza por completo P(x) = x³ − 2x² − x + 2","correcta":"(x − 1)(x + 1)(x − 2)","distractores":[["(x − 1)(x + 1)(x + 2)","signo de un cero"],["(x − 1)²(x − 2)","inventó una raíz doble"],["x(x² − 2x − 1) + 2","factorización incompleta"]]},"dificil":{"texto":"Divide x³ − 4x² + x + 6 entre (x − 2) con división sintética","correcta":"x² − 2x − 3, residuo 0","distractores":[["x² − 6x + 13, residuo −20","usó −2 en lugar de 2"],["x² − 4x + 1, residuo 6","copió los coeficientes sin operar"],["x³ − 2x² − 3x","no bajó el grado"]]}}},{"id":"parciales","nombre":"Derivadas parciales","peso":"1/17","preguntas":{"facil":{"texto":"Si f(x, y) = x²y + 3y, calcula ∂f/∂x","correcta":"2xy","distractores":[["2xy + 3","derivó 3y como si dependiera de x"],["x² + 3","calculó ∂f/∂y"],["2x","trató a y como 1"]]},"media":{"texto":"Si f(x, y) = x sen y, calcula ∂f/∂y","correcta":"x cos y","distractores":[["sen y","derivó respecto a x"],["cos y","olvidó la x"],["−x cos y","signo de la derivada del seno"]]},"dificil":{"texto":"Si f(x, y) = e^(xy), calcula ∂f/∂y","correcta":"x e^(xy)","distractores":[["e^(xy)","olvidó la regla de la cadena"],["y e^(xy)","derivó respecto a x"],["xy e^(xy − 1)","usó la regla de la potencia"]]}}}]}
