existe","se detuvo en 0/0"],["2","simplificó la fracción a x"]]},"dificil":{"texto":"¿Qué valor de k hace continua a f(x) = kx + 1 si x < 2, y f(x) = x² si x ≥ 2?","correcta":"k = 3/2","distractores":[["k = 2","olvidó el +1"],["k = 5/2","despejó con el signo equivocado"],["Cualquier k","no relacionó continuidad con los límites laterales"]]}}},{"id":"trigonometria","nombre":"Identidades trigonométricas","peso":"2/17","preguntas":{"facil":{"texto":"¿A qué es igual 1 − cos²x?","correcta":"sen²x","distractores":[["cos²x","confundió el signo"],["sen x","olvidó el cuadrado"],["tan²x","confundió con la identidad de la tangente"]]},"media":{"texto":"Escribe sen²x en términos del ángulo doble","correcta":"(1 − cos 2x)/2","distractores":[["(1 + cos 2x)/2","es la de cos²x"],["2 sen x cos x","es sen 2x"],["1 − cos 2x","olvidó dividir entre 2"]]},"dificil":{"texto":"Si x = 3 sen θ, con −π/2 ≤ θ ≤ π/2, ¿a qué es igual √(9 − x²)?","correcta":"3 cos θ","distractores":[["3 sen θ","no aplicó la identidad"],["9 cos²θ","olvidó la raíz"],["3 − 3 sen θ","sacó la raíz término por término"]]}}},{"id":"algebra","nombre":"Álgebra básica y funciones","peso":"4/17","preguntas":{"facil":{"texto":"Simplifica (x² − 9)/(x + 3)","correcta":"x − 3","distractores":[["x + 3","factorizó con el signo mal"],["x² − 3","canceló términos sueltos"],["No se puede simplificar","no reconoció la diferencia de cuadrados"]]},"media":{"texto":"Escribe ln(x²/y) como suma y resta de logaritmos","correcta":"2 ln x − ln y","distractores":[["ln 2x − ln y","bajó el exponente dentro del logaritmo"],["2 ln x / ln y","convirtió la resta en división"],["(ln x)² − ln y","elevó el logaritmo"]]},"dificil":{"texto":"¿En qué valores de x se cruzan y = x² y y = x + 2?","correcta":"x = −1 y x = 2","distractores":[["x = 1 y x = −2","signos al factorizar"],["Solo x = 2","perdió una raíz"],["No se cruzan","no igualó las funciones"]]}}},{"id":"polinomios","nombre":"Ceros de polinomios","peso":"1/17","preguntas":{"facil":{"texto":"¿Cuál es un cero de P(x) = x³ − 2x² − x + 2?","correcta":"x = 1","distractores":[["x = 0","no comprobó evaluando P (da 2)"],["x = 3","no comprobó evaluando P (da 8)"],["x = −2","no comprobó evaluando P (da −12)"]]},"media":{"texto":"Factoriza por completo P(x) = x³ − 2x² − x + 2","correcta":"(x − 1)(x + 1)(x − 2)","distractores":[["(x − 1)(x + 1)(x + 2)","signo de un cero"],["(x − 1)²(x − 2)","inventó una raíz doble"],["x(x² − 2x − 1) + 2","factorización incompleta"]]},"dificil":{"texto":"Divide x³ − 4x² + x + 6 entre (x − 2) con división sintética","correcta":"x² − 2x − 3, residuo 0","distractores":[["x² − 6x + 13, residuo −20","usó −2 en lugar de 2"],["x² − 4x + 1, residuo 6","copió los coeficientes sin operar"],["x³ − 2x² − 3x","no bajó el grado"]]}}},{"id":"parciales","nombre":"Derivadas parciales","peso":"1/17","preguntas":{"facil":{"texto":"Si f(x, y) = x²y + 3y, calcula ∂f/∂x","correcta":"2xy","distractores":[["2xy + 3","derivó 3y como si dependiera de x"],["x² + 3","calculó ∂f/∂y"],["2x","trató a y como 1"]]},"media":{"texto":"Si f(x, y) = e^(xy), calcula ∂f/∂y","correcta":"x e^(xy)","distractores":[["e^(xy)","olvidó la regla de la cadena"],["y e^(xy)","derivó respecto a x"],["xy e^(xy − 1)","usó la regla de la potencia"]]},"dificil":{"texto":"¿Cuál es el dominio de f(x, y) = √(4 − x² − y²)?","correcta":"Los puntos con x² + y² ≤ 4: un disco de radio 2","distractores":[["x² + y² ≥ 4","invirtió la desigualdad"],["x² + y² ≤ 2","escribió el radio en lugar del radio al cuadrado"],["Todo el plano","ignoró la raíz"]]}}}]}
